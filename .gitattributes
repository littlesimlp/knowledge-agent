# Normalize line endings: LF in repo, LF in worktree.
# Prevents CRLF files from breaking Linux containers / CI.
* text=auto eol=lf

# Binary: no EOL conversion, no text diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.docx binary
