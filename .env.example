POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=knowledge
# ---- LLM（M3）----
# fake = 不联网；生产/真实体验改成 deepseek 或 siliconflow
LLM_PROVIDER=fake
# 真实 key 只放在 .env，不进库
LLM_API_KEY=
# 留空则用 provider 默认地址
LLM_BASE_URL=
# 必须显式填，例如 deepseek-chat / Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARS=8000